{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resencesite",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resence-db",
      "database_id": "afe2895c-1ed9-4419-a654-95bc5f7a1560"
    }
  ]
}
